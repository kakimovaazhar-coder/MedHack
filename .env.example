# Copy to .env in repository root. No real patient data in this prototype.
MEDHUB_DEMO_ENABLED=true
MEDHUB_DATA_DIR=./data
MEDHUB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Compose publishes on localhost by default. For a trusted team LAN use 0.0.0.0.
MEDHUB_BIND_HOST=127.0.0.1
# Temporary audio/history workspace (one backend process, memory only).
# Example: http://192.168.1.20:9000 on a trusted team LAN.
MEDHUB_WHISPERX_BASE_URL=
MEDHUB_WHISPERX_API_TOKEN=
MEDHUB_WORKSPACE_TTL_SECONDS=3600
# OpenAI is activated for workspace analysis after explicit text review in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
