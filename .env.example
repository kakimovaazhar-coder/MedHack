# Copy to .env in repository root. No real patient data in this prototype.
MEDHUB_DEMO_ENABLED=true
MEDHUB_DATA_DIR=./data
MEDHUB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Compose publishes on localhost by default. For a trusted team LAN use 0.0.0.0.
MEDHUB_BIND_HOST=127.0.0.1
# Reserved for a subsequent implementation; these do not activate integrations yet.
OPENAI_API_KEY=
OPENAI_MODEL=
WHISPERX_BASE_URL=
